// Prisma schema for OUTOFSIGHT — mirrors the shapes in types/content.ts and
// types/portfolio.ts exactly. If you add a field to those types, add the
// matching column here and vice versa; lib/data/content.ts and
// lib/data/portfolio.ts assume they're in sync.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Every *Content model below is a singleton: exactly one row, fixed at
// id = 1. lib/data/content.ts always reads/writes id: 1, creating the row
// with seed defaults on first read if it doesn't exist yet.

model HomeContent {
  id                  Int     @id @default(1)
  heroText            String
  displayMode         String
  backgroundVideoName String?
  backgroundVideoUrl  String?
  logoFileName        String?
}

model ContactsContent {
  id          Int    @id @default(1)
  bodyText    String
  email       String
  countryCode String
  phoneNumber String
  location    String
}

model WorksContent {
  id                Int     @id @default(1)
  heroImage         String?
  heroImagePosition String
  heroHeading       String
  heroDescription   String
}

// ProcessCard[] (title/description pairs) is stored as Json — it's a small,
// fixed-shape array with no query/filter need of its own, so a relational
// table would be overhead without benefit.
model AboutContent {
  id                         Int      @id @default(1)
  heroImage                  String?
  heroImagePosition          String
  heroHeadline               String
  introText                  String
  storyImage                 String?
  storyImagePosition         String
  storyText                  String
  founderPhoto               String?
  founderPhotoPosition       String
  founderName                String
  founderTitle               String
  bio                        String
  linkedinUrl                String
  instagramUrl               String
  processCards               Json
  trustedByLogos             String[]
  ctaText                    String
  ctaBackgroundImage         String?
  ctaBackgroundImagePosition String
}

model Project {
  id                        String   @id @default(cuid())
  slug                      String   @unique
  title                     String
  description               String
  credits                   String
  thumbnailImage            String?
  thumbnailImagePosition    String
  thumbnailLabel            String?
  videoName                 String?
  videoLabel                String?
  videoPreviewImage         String?
  videoPreviewImagePosition String
  photos                    String[]
  tags                      String[]
  createdAt                 DateTime @default(now())
}
